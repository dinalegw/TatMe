generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  ARTIST
  ADMIN
}

enum DesignStatus {
  AVAILABLE
  BOOKED
  SOLD
  CUSTOM_REFERENCE
}

enum BookingType {
  IN_SHOP
  HOUSE_CALL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  DECLINED
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  PAID
  REFUNDED
  FAILED
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  phone          String?
  role           UserRole       @default(CLIENT)
  artistProfile  ArtistProfile?
  clientBookings Booking[]      @relation("ClientBookings")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ArtistProfile {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio            String
  specialties    String[]
  rating         Decimal?       @db.Decimal(2, 1)
  travelRadiusKm Int?
  shopLocations  Location[]
  designs        Design[]
  availability   Availability[]
  bookings       Booking[]      @relation("ArtistBookings")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Design {
  id              String         @id @default(cuid())
  artistProfileId String
  artistProfile   ArtistProfile  @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  imageUrl        String
  styleTags       String[]
  placement       String?
  size            String?
  priceCents      Int
  currency        String         @default("GBP")
  status          DesignStatus   @default(AVAILABLE)
  bookings        Booking[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Location {
  id              String         @id @default(cuid())
  artistProfileId String
  artistProfile   ArtistProfile  @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)
  label           String
  addressLine1    String
  addressLine2    String?
  city            String
  region          String?
  postcode        String
  country         String
  latitude        Decimal?       @db.Decimal(9, 6)
  longitude       Decimal?       @db.Decimal(9, 6)
  availability    Availability[]
  bookings        Booking[]
}

model Availability {
  id              String        @id @default(cuid())
  artistProfileId String
  artistProfile   ArtistProfile @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)
  locationId      String?
  location        Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  bookingType     BookingType
  startsAt        DateTime
  endsAt          DateTime
  travelAddress   String?
  travelRadiusKm  Int?
  createdAt       DateTime      @default(now())
}

model Booking {
  id              String        @id @default(cuid())
  clientId        String
  client          User          @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  artistProfileId String
  artistProfile   ArtistProfile @relation("ArtistBookings", fields: [artistProfileId], references: [id], onDelete: Cascade)
  designId        String?
  design          Design?       @relation(fields: [designId], references: [id], onDelete: SetNull)
  locationId      String?
  location        Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  type            BookingType
  status          BookingStatus @default(PENDING)
  startsAt        DateTime
  endsAt          DateTime
  houseCallAddress String?
  intakeForm      IntakeForm?
  deposit         Deposit?
  waiver          Waiver?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model IntakeForm {
  id             String   @id @default(cuid())
  bookingId      String   @unique
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  style          String
  placement      String
  size           String
  budgetCentsMin Int?
  budgetCentsMax Int?
  notes          String?
  referenceUrls  String[]
  createdAt      DateTime @default(now())
}

model Deposit {
  id                   String        @id @default(cuid())
  bookingId            String        @unique
  booking              Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amountCents          Int
  currency             String        @default("GBP")
  status               PaymentStatus @default(REQUIRES_PAYMENT)
  stripePaymentIntentId String?
  policySnapshot       String
  paidAt               DateTime?
  createdAt            DateTime      @default(now())
}

model Waiver {
  id             String   @id @default(cuid())
  bookingId      String   @unique
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  legalName      String
  dateOfBirth    DateTime
  consentText    String
  signatureUrl   String?
  signedAt       DateTime @default(now())
}
